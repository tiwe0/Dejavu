+// MAP_FIXED. An allocation hint may be ignored; reject mappings outside B range.
+static bool SafeBranchReachable(addr_t from, addr_t to) {
+  return to >= from ? to - from < ARM64_B_XXX_RANGE : from - to <= ARM64_B_XXX_RANGE;
+}
