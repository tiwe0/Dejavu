+#pragma once
+
+#include <vector>
+
+// Strict native hooks only. All calls are serialized by gInterceptorMutex;
+// reservation identities are addresses, never pointers into this vector.
+struct SafeNearPagePool {
+  static constexpr size_t slot_size = 16;
+  struct Page {
+    addr_t address;
+    size_t size;
+    std::vector<uint8_t> slots; // 0: free, 1: reserved, 2: published forever
+    bool quarantined = false;
+  };
+  std::vector<Page> pages;
+
+  addr_t Reserve(addr_t source) {
+    for (auto &page : pages) {
+      if (page.quarantined)
+        continue;
+      for (size_t index = 0; index < page.slots.size(); ++index) {
+        const addr_t slot = page.address + index * slot_size;
+        if (page.slots[index] == 0 && SafeBranchReachable(source, slot)) {
+          page.slots[index] = 1;
+          return slot;
+        }
+      }
+    }
+    const long size = sysconf(_SC_PAGESIZE);
+    if (size < static_cast<long>(slot_size))
+      return 0;
+    void *mapping = AllocateSafeNearPage(source);
+    if (!mapping)
+      return 0;
+    pages.push_back({(addr_t)mapping, (size_t)size,
+                     std::vector<uint8_t>((size_t)size / slot_size, 0), false});
+    pages.back().slots[0] = 1;
+    return (addr_t)mapping;
+  }
+
+  bool Publish(addr_t slot) {
+    for (auto &page : pages) {
+      if (slot >= page.address && slot - page.address < page.size &&
+          (slot - page.address) % slot_size == 0) {
+        auto &state = page.slots[(slot - page.address) / slot_size];
+        if (page.quarantined || state != 1)
+          return false;
+        state = 2;
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void Release(addr_t slot) {
+    for (size_t index = 0; index < pages.size(); ++index) {
+      auto &page = pages[index];
+      if (slot < page.address || slot - page.address >= page.size ||
+          (slot - page.address) % slot_size != 0)
+        continue;
+      auto &state = page.slots[(slot - page.address) / slot_size];
+      if (state != 1)
+        return;
+      state = 0;
+      for (auto occupied : page.slots) {
+        if (occupied != 0)
+          return;
+      }
+      if (munmap((void *)page.address, page.size) == 0) {
+        pages.erase(pages.begin() + index);
+      } else {
+        page.quarantined = true;
+        ERROR_LOG("native hook near-pool munmap failed page=%p size=%zu errno=%d",
+                  (void *)page.address, page.size, errno);
+      }
+      return;
+    }
+  }
+
+  void AbortWrite(addr_t slot) {
+    for (auto &page : pages) {
+      if (slot >= page.address && slot - page.address < page.size) {
+        // Even a -1 code-patch may have widened permissions before failing.
+        // Confirm RX before allowing another reservation on this owned page.
+        if (mprotect((void *)page.address, page.size, PROT_READ | PROT_EXEC) != 0) {
+          page.quarantined = true;
+          ERROR_LOG("native hook near-pool restore failed page=%p size=%zu errno=%d",
+                    (void *)page.address, page.size, errno);
+        }
+        break;
+      }
+    }
+    Release(slot);
+  }
+};
