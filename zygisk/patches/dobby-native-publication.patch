+static void *AllocateSafeNearPage(addr_t source) {
+  const long size = sysconf(_SC_PAGESIZE);
+  if (size <= 0)
+    return nullptr;
+  const addr_t lower = source > ARM64_B_XXX_RANGE ? source - ARM64_B_XXX_RANGE : (addr_t)size;
+  const addr_t upper = source <= UINTPTR_MAX - ARM64_B_XXX_RANGE
+                           ? source + ARM64_B_XXX_RANGE : UINTPTR_MAX;
+  const auto regions = ProcessRuntime::getMemoryLayout();
+  // A hint is advisory and the snapshot can race with other threads. Retry a
+  // few pages in each gap, with a global bound on allocation work.
+  constexpr size_t max_attempts = 64;
+  constexpr size_t max_gap_attempts = 4;
+  size_t attempts = 0;
+  addr_t cursor = lower;
+  for (size_t index = 0; index <= regions.size(); ++index) {
+    const addr_t end = index < regions.size() ? regions[index].addr() : UINTPTR_MAX;
+    if (end > cursor && cursor < upper) {
+      if (cursor > UINTPTR_MAX - (size - 1))
+        break;
+      addr_t candidate = ((cursor + size - 1) / size) * size;
+      size_t gap_attempts = 0;
+      // Only the entry address must be B-reachable; its backing page can
+      // extend past the branch limit as long as it fits the actual gap.
+      while (candidate < end && end - candidate >= (addr_t)size &&
+             SafeBranchReachable(source, candidate) &&
+             gap_attempts < max_gap_attempts && attempts < max_attempts) {
+        ++attempts;
+        ++gap_attempts;
+        void *page = mmap((void *)candidate, size, PROT_READ | PROT_EXEC,
+                          MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        const int allocation_errno = page == MAP_FAILED ? errno : 0;
+        if (page != MAP_FAILED) {
+          if ((addr_t)page % 4 == 0 && SafeBranchReachable(source, (addr_t)page))
+            return page;
+          const int unmap_status = munmap(page, size);
+          const int unmap_errno = unmap_status != 0 ? errno : 0;
+          ERROR_LOG("native hook near-allocation target=%p candidate=%p actual=%p errno=%d "
+                    "unreachable; munmap_status=%d munmap_errno=%d",
+                    (void *)source, (void *)candidate, page, allocation_errno,
+                    unmap_status, unmap_errno);
+        } else {
+          ERROR_LOG("native hook near-allocation target=%p candidate=%p actual=%p errno=%d",
+                    (void *)source, (void *)candidate, page, allocation_errno);
+        }
+        candidate += (addr_t)size;
+      }
+    }
+    if (index < regions.size() && regions[index].end() > cursor)
+      cursor = regions[index].end();
+    if (cursor >= upper || attempts >= max_attempts)
+      break;
+  }
+  ERROR_LOG("native hook near-allocation target=%p search-exhausted attempts=%zu budget=%zu",
+            (void *)source, attempts, max_attempts);
+  return nullptr;
+}
