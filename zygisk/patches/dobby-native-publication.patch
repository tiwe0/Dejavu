+static void *AllocateSafeNearPage(addr_t source) {
+  const long size = sysconf(_SC_PAGESIZE);
+  if (size <= 0)
+    return nullptr;
+  const addr_t lower = source > ARM64_B_XXX_RANGE ? source - ARM64_B_XXX_RANGE : (addr_t)size;
+  const addr_t upper = source <= UINTPTR_MAX - ARM64_B_XXX_RANGE
+                           ? source + ARM64_B_XXX_RANGE : UINTPTR_MAX;
+  const auto regions = ProcessRuntime::getMemoryLayout();
+  addr_t cursor = lower;
+  for (size_t index = 0; index <= regions.size(); ++index) {
+    const addr_t end = index < regions.size() ? regions[index].addr() : upper;
+    if (end > cursor && cursor < upper) {
+      if (cursor > UINTPTR_MAX - (size - 1))
+        break;
+      const addr_t candidate = ((cursor + size - 1) / size) * size;
+      const addr_t gap_end = end < upper ? end : upper;
+      if (candidate < gap_end && gap_end - candidate >= (addr_t)size) {
+        void *page = mmap((void *)candidate, size, PROT_READ | PROT_EXEC,
