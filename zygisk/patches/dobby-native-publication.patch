+#pragma once
+
+#include <mutex>
+
+// Private lifecycle status; not part of the public plugin ABI.
+namespace dejavu_dobby {
+inline constexpr int kHookMutationReentrant = -3;
+
+// Accessed only while holding the interceptor mutex. Other threads wait for
+// the outer mutation; recursive calls on its owning thread fail immediately.
+inline bool hook_mutation_in_progress = false;
+class HookMutationScope {
+ public:
+  explicit HookMutationScope(std::recursive_mutex &mutex) : lock_(mutex) {
+    if (!hook_mutation_in_progress) {
+      hook_mutation_in_progress = true;
+      entered_ = true;
+    }
+  }
+  ~HookMutationScope() {
+    if (entered_)
+      hook_mutation_in_progress = false;
+  }
+  bool entered() const { return entered_; }
+
+ private:
+  std::unique_lock<std::recursive_mutex> lock_;
+  bool entered_ = false;
+};
+} // namespace dejavu_dobby
