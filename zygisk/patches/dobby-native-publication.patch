+#endif
+  return true;
+}
+
+void ReleaseSafeNearTrampoline(Trampoline *trampoline) {
+#if defined(__ANDROID__) || defined(__linux__)
+  if (trampoline && trampoline->strict_near_slot) {
+    const addr_t slot = trampoline->strict_near_slot;
+    trampoline->strict_near_slot = 0;
+    gSafeNearPagePool.Release(slot);
+    delete trampoline->forward_trampoline;
+    trampoline->forward_trampoline = nullptr;
+  }
+#endif
+}
