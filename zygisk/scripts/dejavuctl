#!/usr/bin/env python3

import argparse
from contextlib import contextmanager
import fcntl
import json
import math
import os
from pathlib import Path
import re
import secrets
import shlex
import socket
import struct
import subprocess
import sys
import tempfile
import time


MAX_PAYLOAD_SIZE = 1024 * 1024
RPC_MAGIC = 0x444A5250
RPC_VERSION = 1
RPC_EXECUTE_REQUEST = 1
RPC_EXECUTE_RESPONSE = 2
RPC_RECONNECT_REQUEST = 3
RPC_RECONNECT_RESPONSE = 4
RPC_OK = 0
RPC_EXECUTION_ERROR = 1
RPC_UNAVAILABLE = 2
RPC_PROTOCOL_ERROR = 3
RPC_HEADER = struct.Struct("<IIIiQI")
FRAME_HEADER = struct.Struct("<I")
PROCESS_PATTERN = re.compile(r"[A-Za-z0-9_.:-]{1,128}\Z")
SOCKET_PATTERN = re.compile(r"dejavu-[A-Za-z0-9_.-]+\Z")
DEFAULT_PROCESS = "bin.mt.plus"
RECONNECT_BACKOFF_INITIAL = 0.1
RECONNECT_BACKOFF_MAX = 5.0
WATCH_POLL_INTERVAL = 0.25
ADB_TIMEOUT = 5.0


class ControlError(RuntimeError):
    pass


class OutcomeUnknownError(ControlError):
    pass


@contextmanager
def exclusive_cli_session():
    lock_path = Path(tempfile.gettempdir()) / f"dejavuctl-{os.getuid()}.lock"
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def adb_command(serial, *arguments, check=True, timeout=ADB_TIMEOUT):
    command = [os.environ.get("ADB", "adb")]
    if serial:
        command.extend(["-s", serial])
    command.extend(arguments)
    try:
        return subprocess.run(
            command,
            check=check,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise ControlError("adb command timed out") from error
    except FileNotFoundError as error:
        raise ControlError("adb was not found in PATH") from error
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or error.stdout).strip()
        raise ControlError(detail or f"adb exited with status {error.returncode}") from error


def root_shell(serial, command, check=True):
    remote_command = f"su -c {shlex.quote(command)}"
    return adb_command(serial, "shell", remote_command, check=check)


def read_metadata(serial, process_name):
    pid_output = root_shell(serial, f"pidof {process_name}").stdout.strip()
    pids = [value for value in pid_output.split() if value.isdigit() and int(value) > 0]
    if not pids:
        raise ControlError(f"target process is not running: {process_name}")

    for pid_text in pids:
        path = (
            "/data/adb/modules/dejavu_zygisk/run/"
            f"{process_name}.{pid_text}.rpc"
        )
        result = root_shell(serial, f"cat {path}", check=False)
        if result.returncode != 0:
            continue
        try:
            metadata = json.loads(result.stdout)
        except json.JSONDecodeError:
            continue
        if metadata.get("version") != RPC_VERSION or metadata.get("pid") != int(pid_text):
            continue
        socket_name = metadata.get("socket")
        token_hex = metadata.get("token")
        if (
            not isinstance(socket_name, str)
            or len(socket_name) >= 64
            or SOCKET_PATTERN.fullmatch(socket_name) is None
            or not isinstance(token_hex, str)
            or len(token_hex) != 64
        ):
            continue
        try:
            token = bytes.fromhex(token_hex)
        except ValueError:
            continue
        if len(token) == 32 and any(token):
            return int(pid_text), socket_name, token
    raise ControlError(f"RPC endpoint is not ready for {process_name}")


def wait_for_metadata(serial, process_name, wait_seconds):
    deadline = time.monotonic() + wait_seconds
    while True:
        try:
            return read_metadata(serial, process_name)
        except ControlError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.1)


def remaining_io_time(deadline):
    if deadline is None:
        return None
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise socket.timeout("RPC exchange deadline exceeded")
    return remaining


def set_io_deadline(connection, deadline):
    if deadline is not None:
        connection.settimeout(remaining_io_time(deadline))


def read_exact(connection, size, deadline=None):
    chunks = []
    remaining = size
    while remaining:
        set_io_deadline(connection, deadline)
        chunk = connection.recv(remaining)
        if not chunk:
            raise ControlError("RPC connection closed unexpectedly")
        chunks.append(chunk)
        remaining -= len(chunk)
    remaining_io_time(deadline)
    return b"".join(chunks)


def write_frame(connection, payload, deadline=None):
    if len(payload) > MAX_PAYLOAD_SIZE + RPC_HEADER.size:
        raise ControlError("RPC frame is too large")
    set_io_deadline(connection, deadline)
    connection.sendall(FRAME_HEADER.pack(len(payload)) + payload)
    remaining_io_time(deadline)


def read_frame(connection, maximum_size, deadline=None):
    (size,) = FRAME_HEADER.unpack(read_exact(connection, FRAME_HEADER.size, deadline))
    if size > maximum_size:
        raise ControlError(f"RPC frame exceeds {maximum_size} bytes")
    return read_exact(connection, size, deadline)


def execute_once(port, token, request_type, expected_response_type, script, timeout):
    request_id = secrets.randbits(64) or 1
    request = RPC_HEADER.pack(
        RPC_MAGIC,
        RPC_VERSION,
        request_type,
        RPC_OK,
        request_id,
        len(script),
    ) + script
    deadline = time.monotonic() + timeout
    with socket.create_connection(("127.0.0.1", port), timeout=timeout) as connection:
        write_frame(connection, token, deadline)
        if read_frame(connection, 0, deadline):
            raise ControlError("invalid authentication acknowledgement")
        # sendall can fail after writing part or all of the request.
        try:
            write_frame(connection, request, deadline)
            response = read_frame(connection, RPC_HEADER.size + MAX_PAYLOAD_SIZE, deadline)
        except (ControlError, OSError) as error:
            raise outcome_unknown(error) from error

    if len(response) < RPC_HEADER.size:
        raise outcome_unknown("truncated RPC response")
    magic, version, response_type, status, response_id, payload_size = RPC_HEADER.unpack(
        response[: RPC_HEADER.size]
    )
    payload = response[RPC_HEADER.size :]
    if (
        magic != RPC_MAGIC
        or version != RPC_VERSION
        or response_type != expected_response_type
        or status not in (RPC_OK, RPC_EXECUTION_ERROR, RPC_UNAVAILABLE, RPC_PROTOCOL_ERROR)
        or response_id != request_id
        or payload_size != len(payload)
        or payload_size > MAX_PAYLOAD_SIZE
    ):
        raise outcome_unknown("invalid RPC response")
    return status, payload


def remove_forward(serial, port):
    try:
        adb_command(serial, "forward", "--remove", f"tcp:{port}")
    except (ControlError, OSError) as error:
        print_error(f"warning: could not remove adb forward tcp:{port}; "
                    f"mapping may remain: {error}")


@contextmanager
def forwarded_port(serial, socket_name):
    forward = adb_command(serial, "forward", "tcp:0", f"localabstract:{socket_name}")
    port_text = forward.stdout.strip()
    if not port_text.isdigit():
        raise ControlError(f"adb returned an invalid forwarded port: {port_text!r}")
    port = int(port_text)
    try:
        yield port
    finally:
        remove_forward(serial, port)


def execute_with_port(
    port,
    token,
    request_type,
    expected_response_type,
    script,
    timeout,
    wait_seconds,
):
    deadline = time.monotonic() + wait_seconds
    while True:
        status, payload = execute_once(
            port,
            token,
            request_type,
            expected_response_type,
            script,
            timeout,
        )
        if (
            status == RPC_UNAVAILABLE
            and payload == b"target Agent is not connected"
            and time.monotonic() < deadline
        ):
            time.sleep(0.1)
            continue
        return status, payload


def execute(
    serial,
    socket_name,
    token,
    request_type,
    expected_response_type,
    script,
    timeout,
    wait_seconds,
):
    with forwarded_port(serial, socket_name) as port:
        return execute_with_port(
            port,
            token,
            request_type,
            expected_response_type,
            script,
            timeout,
            wait_seconds,
        )


def render_rpc_error(pid, status, payload):
    labels = {
        RPC_EXECUTION_ERROR: "execution error",
        RPC_UNAVAILABLE: "unavailable",
        RPC_PROTOCOL_ERROR: "protocol error",
    }
    detail = payload.decode("utf-8", errors="replace")
    return ControlError(f"{labels.get(status, f'RPC status {status}')} for pid {pid}: {detail}")


def print_payload(payload):
    sys.stdout.buffer.write(payload)
    if not payload.endswith(b"\n"):
        sys.stdout.buffer.write(b"\n")
    sys.stdout.buffer.flush()


def print_error(error):
    print(f"dejavuctl: {error}", file=sys.stderr)
    sys.stderr.flush()


def is_reconnectable_status(status, payload):
    return status == RPC_UNAVAILABLE and payload == b"target Agent is not connected"


def outcome_unknown(detail):
    return OutcomeUnknownError(
        f"execution outcome unknown: {detail}; command was not replayed; "
        "inspect target state before retrying"
    )


def is_reconnectable_error(error):
    if isinstance(error, socket.timeout):
        return True
    if isinstance(error, OSError):
        return True
    if not isinstance(error, ControlError):
        return False
    return str(error) in (
        "RPC connection closed unexpectedly",
        "invalid authentication acknowledgement",
        "truncated RPC response",
        "invalid RPC response",
    )


def read_command(prompt):
    return input(prompt) + "\n"


def stat_identity(stat_result):
    return (stat_result.st_dev, stat_result.st_ino,
            stat_result.st_mtime_ns, stat_result.st_size)


def file_identity(path):
    return stat_identity(path.stat())


def wait_for_watch_change(path, current_identity):
    reported_error = None
    while True:
        time.sleep(WATCH_POLL_INTERVAL)
        try:
            latest_identity = file_identity(path)
        except OSError as error:
            message = f"cannot watch {path}: {error}"
            if message != reported_error:
                print_error(message)
                reported_error = message
            continue
        if latest_identity != current_identity:
            return latest_identity


class ControlSession:
    def __init__(self, serial, process_name, timeout, wait_seconds):
        self.serial = serial
        self.process_name = process_name
        self.timeout = timeout
        self.wait_seconds = wait_seconds
        self.pid = None
        self.socket_name = None
        self.token = None
        self.port = None
        self.reconnect_pending = False

    def __enter__(self):
        self.refresh_metadata(wait_seconds=self.wait_seconds)
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()

    def close(self):
        if self.port is not None:
            remove_forward(self.serial, self.port)
            self.port = None

    def refresh_metadata(self, wait_seconds=None):
        metadata = (
            read_metadata(self.serial, self.process_name)
            if wait_seconds is None
            else wait_for_metadata(self.serial, self.process_name, wait_seconds)
        )
        pid, socket_name, token = metadata
        metadata_changed = (
            self.port is not None
            and (pid != self.pid or socket_name != self.socket_name or token != self.token)
        )
        port = self.port
        if metadata_changed and self.port is not None:
            remove_forward(self.serial, self.port)
            self.port = None
            port = None
        if port is None:
            forward = adb_command(self.serial, "forward", "tcp:0", f"localabstract:{socket_name}")
            port_text = forward.stdout.strip()
            if not port_text.isdigit():
                raise ControlError(f"adb returned an invalid forwarded port: {port_text!r}")
            port = int(port_text)
        self.pid = pid
        self.socket_name = socket_name
        self.token = token
        self.port = port
        return self.pid

    def execute(self, script):
        if self.reconnect_pending:
            self.reconnect()
        if self.port is None:
            self.refresh_metadata(wait_seconds=self.wait_seconds)
        return execute_with_port(
            self.port,
            self.token,
            RPC_EXECUTE_REQUEST,
            RPC_EXECUTE_RESPONSE,
            script,
            self.timeout,
            self.wait_seconds,
        )

    def reconnect(self):
        previous_pid = self.pid
        last_error = ControlError("Agent reconnect probe failed")
        delay = RECONNECT_BACKOFF_INITIAL
        deadline = time.monotonic() + self.wait_seconds
        single_attempt_only = self.wait_seconds <= 0
        self.close()
        while True:
            try:
                self.refresh_metadata(
                    wait_seconds=0 if single_attempt_only else max(0.0, deadline - time.monotonic())
                )
                status, payload = execute_with_port(
                    self.port,
                    self.token,
                    RPC_RECONNECT_REQUEST,
                    RPC_RECONNECT_RESPONSE,
                    b"",
                    self.timeout if single_attempt_only else min(
                        self.timeout, max(0.001, deadline - time.monotonic())),
                    0 if single_attempt_only else max(0.0, deadline - time.monotonic()),
                )
                if status != RPC_OK:
                    last_error = render_rpc_error(self.pid, status, payload)
                else:
                    remaining = deadline - time.monotonic()
                    if not single_attempt_only and remaining <= 0:
                        raise ControlError("Agent reconnect deadline exceeded")
                    status, payload = execute_with_port(
                        self.port, self.token, RPC_EXECUTE_REQUEST, RPC_EXECUTE_RESPONSE,
                        b"return true",
                        self.timeout if single_attempt_only else min(self.timeout, remaining),
                        0 if single_attempt_only else remaining,
                    )
                    if status == RPC_OK and payload == b"true":
                        if self.pid != previous_pid:
                            print(
                                f"dejavuctl: reattached to pid {self.pid} after restart",
                                file=sys.stderr,
                            )
                        else:
                            print(f"dejavuctl: reconnected to pid {self.pid}", file=sys.stderr)
                        sys.stderr.flush()
                        self.reconnect_pending = False
                        return
                    last_error = (
                        render_rpc_error(self.pid, status, payload)
                        if status != RPC_OK
                        else ControlError("Agent reconnect probe failed")
                    )
            except (ControlError, OSError, socket.error) as error:
                last_error = error
            if single_attempt_only:
                raise last_error
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise last_error
            time.sleep(min(delay, remaining))
            delay = min(delay * 2, RECONNECT_BACKOFF_MAX)


def parse_arguments():
    parser = argparse.ArgumentParser(
        description="Execute Lua management code in a running Dejavu Agent."
    )
    parser.add_argument("positionals", nargs="*", metavar="ARG")
    parser.add_argument("-e", "--execute", metavar="CODE", help="inline Lua code")
    parser.add_argument(
        "-i",
        "--repl",
        action="store_true",
        help="read and execute one line of Lua at a time until exit/quit/EOF",
    )
    parser.add_argument(
        "--watch",
        metavar="FILE",
        help="watch a Lua file and execute it whenever it changes",
    )
    parser.add_argument(
        "--reconnect",
        action="store_true",
        help="reset and verify the Agent RPC connection",
    )
    parser.add_argument(
        "-p", "--process", dest="process_option", metavar="PROCESS", help="target process name"
    )
    parser.add_argument("-s", "--serial", default=os.environ.get("ADB_SERIAL"))
    parser.add_argument("--wait", type=float, default=5.0, metavar="SECONDS")
    parser.add_argument(
        "--timeout", type=float, default=40.0, metavar="SECONDS",
        help="RPC RPC exchange deadline in seconds (default: 40); does not cancel remote Lua",
    )
    arguments = parser.parse_args()
    arguments.script = None
    arguments.process_arg = None
    positionals = arguments.positionals
    if arguments.watch is not None or arguments.repl or arguments.execute is not None or arguments.reconnect:
        if len(positionals) > 1:
            parser.error("too many positional arguments")
        if positionals:
            arguments.process_arg = positionals[0]
    else:
        if len(positionals) > 2:
            parser.error("too many positional arguments")
        if positionals:
            arguments.script = positionals[0]
        if len(positionals) == 2:
            arguments.process_arg = positionals[1]
    source_count = sum(
        (
            arguments.execute is not None,
            arguments.script is not None,
            arguments.reconnect,
            arguments.repl,
            arguments.watch is not None,
        )
    )
    if source_count != 1:
        parser.error("use exactly one of a script file, --execute, --repl, --watch or --reconnect")
    if arguments.process_option and arguments.process_arg:
        parser.error("process name was specified twice")
    if (not math.isfinite(arguments.wait) or not math.isfinite(arguments.timeout)
            or arguments.wait < 0 or arguments.timeout <= 0):
        parser.error("--wait must be finite and non-negative and --timeout must be finite and positive")
    return arguments


def load_script(arguments):
    if arguments.execute is not None:
        script = arguments.execute.encode("utf-8")
    else:
        script = load_script_file(arguments.script)
    validate_script(script)
    return script


def validate_script(script):
    if not script:
        raise ControlError("Lua script is empty")
    if len(script) > MAX_PAYLOAD_SIZE:
        raise ControlError(f"Lua script exceeds {MAX_PAYLOAD_SIZE} bytes")
    if b"\0" in script:
        raise ControlError("Lua script contains a NUL byte")
    return script


def load_script_snapshot(path_text):
    # Bind the bytes and watch identity to the same open file. Atomic saves may
    # replace the pathname between observation and opening; in-place edits must
    # finish before a snapshot can be dispatched.
    for _ in range(3):
        try:
            with Path(path_text).open("rb") as source:
                before = stat_identity(os.fstat(source.fileno()))
                script = source.read(MAX_PAYLOAD_SIZE + 1)
                after = stat_identity(os.fstat(source.fileno()))
        except OSError as error:
            raise ControlError(f"cannot read {path_text}: {error}") from error
        if before == after:
            validate_script(script)
            return script, after
    raise ControlError(f"cannot read {path_text}: file changed while reading")


def load_script_file(path_text):
    return load_script_snapshot(path_text)[0]


def execute_with_reconnect(session, script):
    # Only an explicit pre-dispatch rejection proves replay is safe. One
    # reconnect attempt also prevents a permanently missing Agent looping forever.
    for attempt in range(2):
        try:
            status, payload = session.execute(script)
        except (ControlError, OSError) as error:
            if isinstance(error, OutcomeUnknownError) or is_reconnectable_error(error):
                session.reconnect_pending = True
                if isinstance(error, OutcomeUnknownError):
                    raise
                raise outcome_unknown(error) from error
            raise
        if status == RPC_UNAVAILABLE and not is_reconnectable_status(status, payload):
            session.reconnect_pending = True
            raise outcome_unknown(payload.decode("utf-8", errors="replace"))
        if not is_reconnectable_status(status, payload) or attempt == 1:
            return status, payload
        print_error(
            f"{render_rpc_error(session.pid, status, payload)}; requesting Agent reconnect"
        )
        session.reconnect()


def execute_with_status_reconnect(session, script):
    return execute_with_reconnect(session, script)


def run_repl(session):
    had_error = False
    while True:
        try:
            line = read_command("dejavu> ")
        except EOFError:
            sys.stdout.write("\n")
            sys.stdout.flush()
            break
        command = line.rstrip("\n")
        if command.strip() in ("exit", "quit"):
            break
        if not command.strip():
            continue
        try:
            status, payload = execute_with_reconnect(session, command.encode("utf-8"))
            if status == RPC_OK:
                print_payload(payload)
            else:
                had_error = True
                print_error(render_rpc_error(session.pid, status, payload))
        except (ControlError, OSError, socket.error) as error:
            had_error = True
            print_error(error)
    return 1 if had_error else 0


def run_watch(session, file_path):
    had_error = False
    path = Path(file_path)
    try:
        current_identity = file_identity(path)
    except OSError as error:
        raise ControlError(f"cannot watch {file_path}: {error}") from error
    last_dispatched_identity = None
    while True:
        try:
            try:
                script, current_identity = load_script_snapshot(file_path)
                if current_identity != last_dispatched_identity:
                    last_dispatched_identity = current_identity
                    status, payload = execute_with_reconnect(session, script)
                    if status == RPC_OK:
                        print_payload(payload)
                    else:
                        had_error = True
                        print_error(render_rpc_error(session.pid, status, payload))
                current_identity = wait_for_watch_change(path, current_identity)
            except (ControlError, OSError, socket.error) as error:
                had_error = True
                print_error(error)
                current_identity = wait_for_watch_change(path, current_identity)
        except KeyboardInterrupt:
            print(file=sys.stderr)
            return 1 if had_error else 0


def run_single_command(arguments, process_name):
    with exclusive_cli_session():
        with ControlSession(
            arguments.serial,
            process_name,
            arguments.timeout,
            arguments.wait,
        ) as session:
            if arguments.reconnect:
                session.reconnect()
                print_payload(b"Agent reconnected")
                return 0
            script = load_script(arguments)
            status, payload = execute_with_status_reconnect(session, script)
            if status == RPC_OK:
                print_payload(payload)
                return 0
            raise render_rpc_error(session.pid, status, payload)


def main():
    arguments = parse_arguments()
    process_name = arguments.process_option or arguments.process_arg or DEFAULT_PROCESS
    if PROCESS_PATTERN.fullmatch(process_name) is None:
        raise ControlError(f"invalid process name: {process_name}")
    if arguments.repl or arguments.watch is not None:
        with exclusive_cli_session():
            with ControlSession(
                arguments.serial,
                process_name,
                arguments.timeout,
                arguments.wait,
            ) as session:
                if arguments.repl:
                    return run_repl(session)
                return run_watch(session, arguments.watch)
    return run_single_command(arguments, process_name)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print(file=sys.stderr)
        sys.exit(0)
    except (ControlError, OSError, socket.error) as error:
        print(f"dejavuctl: {error}", file=sys.stderr)
        sys.exit(1)
