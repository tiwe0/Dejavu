+/* DejaVu: relocation errors are fatal by default in TCC (tcc_error calls
+   exit() outside the compile-time jump buffer). Route them through the
+   error callback and return -1 so embedders can handle failure. The error
+   macros enter the TCC state before reporting, so release it here as the
+   compile-time longjmp handler does. */
+LIBTCCAPI int tcc_relocate(TCCState *s1, void *ptr)
+{
+    int result;
+
+    if (setjmp(s1->error_jmp_buf) != 0) {
+        s1->error_set_jmp_enabled = 0;
+        tcc_exit_state();
+        return -1;
+    }
+    s1->error_set_jmp_enabled = 1;
+    result = tcc_relocate_unprotected(s1, ptr);
+    if (tcc_state != NULL) {
+        /* A non-aborting diagnostic (tcc_error_noabort) entered the TCC state
+           but did not leave it; release it before returning. */
+        s1->error_set_jmp_enabled = 0;
+        tcc_exit_state();
+        return -1;
+    }
+    s1->error_set_jmp_enabled = 0;
+    return result;
+}
