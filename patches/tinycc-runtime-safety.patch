+/* DejaVu: runtime page-size mask used to keep writable data sections off the
+   executable pages marked by set_pages_executable() below. */
+static unsigned tinycc_page_size_mask(void)
+{
+#ifdef _WIN32
+    return 4095;
+#else
+    long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size < 2)
+        page_size = 4096;
+    return (unsigned)(page_size - 1);
+#endif
+}
